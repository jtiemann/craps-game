{
  "name": "craps-game",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "dev": "concurrently --names 'server,client' --prefix-colors 'cyan,magenta' 'npm run dev --workspace=server' 'npm run dev --workspace=client'",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "test": "npm run test --workspace=server",
    "test:watch": "npm run test:watch --workspace=server",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
